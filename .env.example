# --- Django asosiy sozlamalari ---
DJANGO_SECRET_KEY=django-insecure-dokonify-secret-key-abdulaziz-xurramov-2026
DJANGO_DEBUG=True
# Productionda: DJANGO_ALLOWED_HOSTS=ichimliklar.uz,www.ichimliklar.uz
DJANGO_ALLOWED_HOSTS=*

# --- Ma'lumotlar bazasi ---
# Productionda (Render Postgres / Neon / Supabase):
#   DATABASE_URL=postgresql://user:parol@host:5432/dbname
# DATABASE_URL bo'lmasa lokal SQLite ishlatiladi:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# DATABASE_URL=postgresql://user:parol@host:5432/dbname

# --- Google OAuth 2.0 ---
# https://console.cloud.google.com/ dan olinadi
GOOGLE_CLIENT_ID=sizning-client-id.apps.googleusercontent.com
